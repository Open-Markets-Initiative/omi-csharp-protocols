<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Generated C# parser for Iex Equities DeepPlus IexTp v1.05.</Description>
    <Version>1.0.0</Version>
    <IsPackable Condition="'$(MSBuildProjectName)' != 'Iex.IexEquities.DeepPlus.IexTp.v1.05'">false</IsPackable>
    <PackageId Condition="'$(MSBuildProjectName)' == 'Iex.IexEquities.DeepPlus.IexTp.v1.05'">Iex.IexEquities.DeepPlus.IexTp.v1.05.Classes</PackageId>
    <AssemblyName Condition="'$(MSBuildProjectName)' == 'Iex.IexEquities.DeepPlus.IexTp.v1.05'">Iex.IexEquities.DeepPlus.IexTp.v1.05.Classes</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="'$(MSBuildProjectName)' == 'Iex.IexEquities.DeepPlus.IexTp.v1.05'">ReadMe.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Iex.IexEquities.DeepPlus.IexTp.v1.05'">
    <None Include="$(MSBuildThisFileDirectory)ReadMe.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Open-Markets-Initiative/omi-csharp-protocols</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Open-Markets-Initiative/omi-csharp-protocols</PackageProjectUrl>
  </PropertyGroup>
</Project>
