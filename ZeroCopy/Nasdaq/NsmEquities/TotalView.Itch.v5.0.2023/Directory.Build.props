<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Generated C# parser for Nasdaq Stock Market TotalView Itch v5.0.2023.</Description>
    <Version>1.0.0</Version>
    <IsPackable Condition="'$(MSBuildProjectName)' != 'Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023'">false</IsPackable>
    <PackageId Condition="'$(MSBuildProjectName)' == 'Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023'">Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023.ZeroCopy</PackageId>
    <AssemblyName Condition="'$(MSBuildProjectName)' == 'Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023'">Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023.ZeroCopy</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="'$(MSBuildProjectName)' == 'Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023'">ReadMe.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Nasdaq.NsmEquities.TotalView.Itch.v5.0.2023'">
    <None Include="$(MSBuildThisFileDirectory)ReadMe.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Open-Markets-Initiative/omi-csharp-protocols</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Open-Markets-Initiative/omi-csharp-protocols</PackageProjectUrl>
  </PropertyGroup>
</Project>
